#!/usr/bin/env bash
# Auto-bump ak plugin version when committed plugin files change.
# Runs as pre-commit because git refresh_cache() is called after pre-commit
# (not after prepare-commit-msg or commit-msg), so file modifications + git add
# during this hook reliably land in the commit being created.
#
# Bump type:
#   default                    -> patch
#   AK_BUMP=minor git commit   -> minor
#   AK_BUMP=major git commit   -> major
#   AK_BUMP=skip / AK_NO_BUMP=1 -> no bump
#
# Also skipped when the staged diff already changes the version field
# (caller already bumped manually, e.g. via scripts/bump.sh).
#
# Pre-commit cannot read the in-progress commit message reliably across -m
# and editor flows, so we do not parse Conventional Commits subjects here.
# Use AK_BUMP=... for explicit minor/major bumps.

set -e

case "${AK_BUMP:-${AK_NO_BUMP:-}}" in
  skip|1) exit 0 ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel)
PLUGIN_JSON="$REPO_ROOT/plugin/.claude-plugin/plugin.json"
MARKETPLACE_JSON="$REPO_ROOT/.claude-plugin/marketplace.json"

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(plugin/|\.claude-plugin/marketplace\.json$)' || true)
[ -z "$CHANGED" ] && exit 0

# If staged diff already touches a "version" line in either manifest,
# assume the caller bumped manually and skip auto-bump.
if git diff --cached -- "$PLUGIN_JSON" "$MARKETPLACE_JSON" 2>/dev/null | grep -qE '^\+\s*"version"'; then
  exit 0
fi

BUMP="${AK_BUMP:-patch}"
case "$BUMP" in
  major|minor|patch) ;;
  *) echo "[ak pre-commit] invalid AK_BUMP='$BUMP' (use major|minor|patch|skip)" >&2; exit 1 ;;
esac

CURRENT=$(python3 -c "import json; print(json.load(open('$PLUGIN_JSON'))['version'])")
IFS='.' read -r MAJ MIN PAT <<< "$CURRENT"
case "$BUMP" in
  major) MAJ=$((MAJ + 1)); MIN=0; PAT=0 ;;
  minor) MIN=$((MIN + 1)); PAT=0 ;;
  patch) PAT=$((PAT + 1)) ;;
esac
NEW="$MAJ.$MIN.$PAT"

python3 <<PY
import json
plugin_path = "$PLUGIN_JSON"
mp_path = "$MARKETPLACE_JSON"
new = "$NEW"

with open(plugin_path) as f:
    d = json.load(f)
d["version"] = new
with open(plugin_path, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")

with open(mp_path) as f:
    d = json.load(f)
for p in d.get("plugins", []):
    if p.get("name") == "ak":
        p["version"] = new
with open(mp_path, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
PY

git add "$PLUGIN_JSON" "$MARKETPLACE_JSON"
echo "[ak pre-commit] version $CURRENT -> $NEW ($BUMP)" >&2
